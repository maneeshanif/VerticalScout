# ===========================
# Supabase Cloud PostgreSQL
# ===========================
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ===========================
# Auth / JWT
# ===========================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================
# AI Providers (via LiteLLM inside OpenAI Agents SDK)
# ===========================

# PRIMARY: Gemini 2.0 Flash — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# FALLBACK: OpenRouter (free tier) — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: Only needed if using OpenAI models or if you want
# traces sent to OpenAI platform
OPENAI_API_KEY=sk-...

# Model selection (LiteLLM model name format: "litellm/provider/model")
PRIMARY_MODEL=litellm/gemini/gemini-2.0-flash
FALLBACK_MODEL=litellm/openrouter/meta-llama/llama-3.1-8b-instruct:free

# Set to "1" to stop sending agent traces to OpenAI platform
# (Sentry still captures via OpenAIAgentsIntegration)
OPENAI_AGENTS_DISABLE_TRACING=0

# ===========================
# Sentry
# ===========================
# Get DSN from https://sentry.io → Project → Settings → Client Keys
SENTRY_DSN=https://...@sentry.io/...
# Set to true to include prompt/response content in Sentry spans (use with care)
SENTRY_SEND_PII=false

# ===========================
# AI Rate Limits
# ===========================
ELITE_AI_CALLS_PER_DAY=10
LEAD_TEACHER_AI_CALLS_PER_30_MIN=5

# ===========================
# App
# ===========================
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
